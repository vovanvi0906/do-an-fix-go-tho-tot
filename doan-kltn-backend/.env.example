REDIS_HOST="localhost"

# Authentication (JWT)
JWT_ACCESS_SECRET="daihoccongnghieptphcm"
JWT_ACCESS_EXPIRES_IN="15m"

# AI Microservice (FastAPI chạy local port 8000)
AI_SERVICE_URL="http://localhost:8000"
AI_CONFIDENCE_THRESHOLD="0.6"
