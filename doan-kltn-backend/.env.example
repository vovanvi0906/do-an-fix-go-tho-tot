# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS khớp mặc định với docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ondemand_db?schema=public"

# Cache & Realtime state (Redis 7 Docker port 6380)
