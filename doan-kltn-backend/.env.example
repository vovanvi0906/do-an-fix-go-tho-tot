# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS khớp mặc định với docker-compose.yml)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>?schema=public"

# Cache & Realtime state (Redis 7 Docker port 6380)
REDIS_URL="redis://localhost:6380"
REDIS_PORT=6380
REDIS_HOST="localhost"

# Authentication (JWT)
JWT_ACCESS_SECRET="<YOUR_JWT_SECRET>"
JWT_ACCESS_EXPIRES_IN="15m"

# AI Microservice (FastAPI chạy local port 8000)
AI_SERVICE_URL="http://localhost:8000"
AI_CONFIDENCE_THRESHOLD="0.6"

# SMTP Email (Nodemailer - dùng cho gửi OTP Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="<YOUR_EMAIL>@gmail.com"
SMTP_PASS="<YOUR_GMAIL_APP_PASSWORD>"

# eSMS Gateway (Gửi tin nhắn SMS OTP thật qua eSMS.vn)
ESMS_API_KEY="<YOUR_ESMS_API_KEY>"
ESMS_SECRET_KEY="<YOUR_ESMS_SECRET_KEY>"
ESMS_BRANDNAME="Baotrixemay"
ESMS_SMS_TYPE="2"
ESMS_SANDBOX="0"

# Google OAuth 2.0 (Dùng để xác thực idToken từ Google Sign-In)
GOOGLE_CLIENT_ID="<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com"
GOOGLE_FIREBASE_WEB_CLIENT_ID="<YOUR_FIREBASE_WEB_CLIENT_ID>.apps.googleusercontent.com"
GOOGLE_ANDROID_CLIENT_ID="<YOUR_GOOGLE_ANDROID_CLIENT_ID>.apps.googleusercontent.com"

# Firebase Admin SDK (Dùng để xác thực Firebase idToken)
FIREBASE_PROJECT_ID="<YOUR_FIREBASE_PROJECT_ID>"
FIREBASE_SERVICE_ACCOUNT_PATH="firebase-service-account.json"
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Cloudinary Configuration (Upload Avatar & Media)
CLOUDINARY_CLOUD_NAME="<YOUR_CLOUDINARY_CLOUD_NAME>"
CLOUDINARY_API_KEY="<YOUR_CLOUDINARY_API_KEY>"
CLOUDINARY_API_SECRET="<YOUR_CLOUDINARY_API_SECRET>"
