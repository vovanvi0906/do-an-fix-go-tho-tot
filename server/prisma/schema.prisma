generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, postgis]
}

model User {
  id               String            @id @default(uuid())
  phone            String?           @unique
  name             String?
  email            String?           @unique
  passwordHash     String?
  role             UserRole          @default(CUSTOMER)
  avatarUrl        String?
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isEmailVerified  Boolean           @default(false) @map("is_email_verified")
  googleId         String?           @unique @map("google_id")
  customerProfile  CustomerProfile?
  customerOrders   Order[]           @relation("CustomerOrders")
  biometricReviews BiometricReview[] @relation("BiometricReviewer")
  workerProfile    WorkerProfile?

  @@map("users")
}

model CustomerProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  fullName  String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]   @relation("CustomerProfileOrders")
  reviews   Review[]
  wallet    Wallet?

  @@map("customer_profiles")
}

model WorkerProfile {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  faceVerifiedAt     DateTime?
  rating             Float                    @default(5.0)
  isOnline           Boolean                  @default(false)
  currentLat         Float?
  currentLng         Float?
  serviceCategoryIds String[]                 @default([])
  kycStatus          KycStatus                @default(PENDING)
  fullName           String?
  avatarUrl          String?
  approvalStatus     WorkerApprovalStatus     @default(DRAFT)
  idCardNumber       String?
  idCardVerified     Boolean                  @default(false)
  skills             String[]                 @default([])
  bio                String?
  experienceYears    Int?
  ratingAvg          Float                    @default(5.0)
  totalReviews       Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  currentLocation    Unsupported("geometry")?
  faceState          BiometricState?
  identityReviews    BiometricReview[]
  biometricTemplates BiometricTemplate[]
  biometricSessions  BiometricSession[]
  biometricProofs    BiometricProof[]
  faceProfile        FaceProfile?
  orders             Order[]                  @relation("WorkerOrders")
  reviews            Review[]                 @relation("WorkerReviews")
  wallet             Wallet?
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerServices     WorkerService[]
  workerWallet       WorkerWallet?

  @@unique([id, userId], map: "biometric_worker_identity_key")
  @@index([currentLocation], type: Gist)
  @@index([currentLat, currentLng])
  @@map("worker_profiles")
}

model Address {
  id         String          @id @default(uuid())
  customerId String
  title      String?
  street     String
  ward       String?
  district   String?
  city       String?
  latitude   Float
  longitude  Float
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("addresses")
}

model ServiceCategory {
  id                String          @id @default(uuid())
  name              String
  basePrice         Decimal         @default(100000) @db.Decimal(12, 2)
  unit              String          @default("lần")
  estimatedMinutes  Int             @default(60)
  warrantyDays      Int             @default(30)
  slug              String?         @unique
  description       String?
  icon              String?
  iconUrl           String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  aiSuggestedOrders Order[]         @relation("AISuggestedCategoryOrders")
  orders            Order[]         @relation("CategoryOrders")
  targets           ServiceTarget[]
  services          Service[]

  @@map("service_categories")
}

model ServiceTarget {
  id          String          @id @default(uuid())
  categoryId  String
  name        String
  slug        String?         @unique
  icon        String?
  description String?
  aiPrompts   String[]        @default([])
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services    Service[]

  @@map("service_targets")
}

model Service {
  id                   String          @id @default(uuid())
  categoryId           String
  targetId             String?
  name                 String
  slug                 String?         @unique
  description          String?
  basePrice            Decimal         @db.Decimal(12, 2)
  maxPrice             Decimal?        @db.Decimal(12, 2)
  unit                 String?
  estimatedDurationMin Int?
  isPopular            Boolean         @default(false)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  orders               Order[]
  category             ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  target               ServiceTarget?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  workerServices       WorkerService[]

  @@map("services")
}

model WorkerService {
  id          String        @id @default(uuid())
  workerId    String
  serviceId   String
  customPrice Decimal?      @db.Decimal(12, 2)
  isAvailable Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, serviceId])
  @@map("worker_services")
}

model Order {
  id                    String               @id @default(uuid())
  customerId            String
  workerId              String?
  categoryId            String
  status                OrderStatus          @default(PENDING_AI)
  addressText           String
  lat                   Float
  lng                   Float
  note                  String?
  aiSuggestedCategoryId String?
  aiConfidence          Float?
  estimatedPrice        Decimal              @db.Decimal(12, 2)
  finalPrice            Decimal?             @db.Decimal(12, 2)
  commissionPercent     Float                @default(15.0)
  scheduledAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  pickupAddress         String?
  pickupLat             Float?
  pickupLng             Float?
  totalPrice            Decimal?             @db.Decimal(12, 2)
  commissionRate        Float?               @default(0.15)
  serviceId             String?
  customerProfileId     String?
  addressId             String?
  cancellationReason    String?
  cancelledBy           String?
  startedAt             DateTime?
  completedAt           DateTime?
  aiAnalyses            AIAnalysis[]
  commissionRecord      CommissionRecord?
  biometricSessions     BiometricSession[]
  biometricProofs       BiometricProof[]
  faceVerifications     FaceVerification[]
  images                OrderImage[]
  statusHistory         OrderStatusHistory[]
  address               Address?             @relation(fields: [addressId], references: [id])
  aiSuggestedCategory   ServiceCategory?     @relation("AISuggestedCategoryOrders", fields: [aiSuggestedCategoryId], references: [id])
  category              ServiceCategory      @relation("CategoryOrders", fields: [categoryId], references: [id])
  customer              User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  customerProfile       CustomerProfile?     @relation("CustomerProfileOrders", fields: [customerProfileId], references: [id])
  service               Service?             @relation(fields: [serviceId], references: [id])
  worker                WorkerProfile?       @relation("WorkerOrders", fields: [workerId], references: [id])
  payment               Payment?
  review                Review?
  walletTransactions    WalletTransaction[]

  @@index([status])
  @@index([workerId])
  @@index([customerId])
  @@index([categoryId])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_histories")
}

model OrderImage {
  id           String         @id @default(uuid())
  orderId      String
  type         OrderImageType @default(ISSUE)
  url          String
  aiMatchScore Float?
  uploadedAt   DateTime       @default(now())
  imageUrl     String?
  imageType    String?
  description  String?
  createdAt    DateTime       @default(now())
  aiAnalyses   AIAnalysis[]
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_images")
}

model FaceProfile {
  id            String             @id @default(uuid())
  workerId      String             @unique
  facePhotoUrl  String
  faceEmbedding Json?
  isRegistered  Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  worker        WorkerProfile      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  verifications FaceVerification[]

  @@map("face_profiles")
}

model FaceVerification {
  id               String      @id @default(uuid())
  faceProfileId    String
  orderId          String?
  capturedPhotoUrl String
  similarityScore  Float
  isMatched        Boolean
  verifiedAt       DateTime    @default(now())
  faceProfile      FaceProfile @relation(fields: [faceProfileId], references: [id], onDelete: Cascade)
  order            Order?      @relation(fields: [orderId], references: [id])

  @@map("face_verifications")
}

model AIAnalysis {
  id            String      @id @default(uuid())
  orderId       String
  orderImageId  String?
  analysisType  String
  resultSummary String?
  rawResult     Json?
  confidence    Float?
  createdAt     DateTime    @default(now())
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderImage    OrderImage? @relation(fields: [orderImageId], references: [id])

  @@map("ai_analyses")
}

model Payment {
  id                 String            @id @default(uuid())
  orderId            String            @unique
  amount             Decimal           @db.Decimal(12, 2)
  commissionAmount   Decimal           @default(0) @db.Decimal(12, 2)
  workerPayoutAmount Decimal           @default(0) @db.Decimal(12, 2)
  method             String            @default("VNPAY")
  status             String            @default("PENDING")
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  paymentMethod      String?
  transactionCode    String?
  commissionRecord   CommissionRecord?
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model CommissionRecord {
  id               String   @id @default(uuid())
  orderId          String   @unique
  paymentId        String?  @unique
  grossAmount      Decimal  @db.Decimal(12, 2)
  commissionRate   Float
  commissionAmount Decimal  @db.Decimal(12, 2)
  workerEarnings   Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment          Payment? @relation(fields: [paymentId], references: [id])

  @@map("commission_records")
}

model WorkerWallet {
  id           String              @id @default(uuid())
  workerId     String              @unique
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  worker       WorkerProfile       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_wallets")
}

model Wallet {
  id           String              @id @default(uuid())
  workerId     String?             @unique
  customerId   String?             @unique
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  currency     String              @default("VND")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  customer     CustomerProfile?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  worker       WorkerProfile?      @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id             String                @id @default(uuid())
  walletId       String
  legacyWalletId String?
  orderId        String?
  amount         Decimal               @db.Decimal(12, 2)
  type           WalletTransactionType @default(PAYOUT)
  createdAt      DateTime              @default(now())
  description    String?
  balanceBefore  Decimal?              @db.Decimal(12, 2)
  balanceAfter   Decimal?              @db.Decimal(12, 2)
  legacyWallet   Wallet?               @relation(fields: [legacyWalletId], references: [id], onDelete: Cascade)
  order          Order?                @relation(fields: [orderId], references: [id])
  workerWallet   WorkerWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([orderId])
  @@map("wallet_transactions")
}

model Review {
  id         String           @id @default(uuid())
  orderId    String           @unique
  rating     Int
  comment    String?
  createdAt  DateTime         @default(now())
  customerId String?
  workerId   String?
  updatedAt  DateTime?        @updatedAt
  customer   CustomerProfile? @relation(fields: [customerId], references: [id])
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker     WorkerProfile?   @relation("WorkerReviews", fields: [workerId], references: [id])

  @@map("reviews")
}

model SystemSetting {
  id                    String   @id @default(uuid())
  siteName              String   @default("FixGo - Nền tảng Dịch vụ Cứu hộ & Sửa chữa")
  supportEmail          String   @default("support@fixgo.vn")
  supportHotline        String   @default("1900-8888")
  maxSearchRadiusKm     Float    @default(15.0)
  defaultCommissionRate Float    @default(15.0)
  orderTimeoutSeconds   Int      @default(60)
  autoMatching          Boolean  @default(true)
  notifyOnArrival       Boolean  @default(true)
  smsOtpEnabled         Boolean  @default(true)
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String?  @default("Hệ thống đang bảo trì nâng cấp định kỳ. Xin vui lòng quay lại sau ít phút!")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("system_settings")
}

model Voucher {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String?
  discountType  String   @default("PERCENTAGE")
  discountValue Decimal  @db.Decimal(12, 2)
  minOrderValue Decimal? @db.Decimal(12, 2)
  maxDiscount   Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  startDate     DateTime @default(now())
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("vouchers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum WorkerApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_AI
  AWAITING_CONFIRM
  SEARCHING_WORKER
  MATCHED
  WORKER_EN_ROUTE
  IN_PROGRESS
  AWAITING_ACCEPTANCE
  DISPUTED
  COMPLETED
  PAID
  CANCELLED
  CREATED
  SEARCHING
  ASSIGNED
  WORKER_ARRIVING
  ARRIVED
  AWAITING_CONFIRMATION
  AWAITING_PAYMENT
}

enum OrderImageType {
  ISSUE
  BEFORE
  AFTER
}

enum WalletTransactionType {
  PAYOUT
  WITHDRAW
}

// Additive Face Core v2. Legacy FaceProfile/FaceVerification remain untouched.
model BiometricState {
  workerId       String        @id
  epoch          Int           @default(0)
  lastVersion    Int           @default(0)
  consentVersion String?
  consentedAt    DateTime?
  withdrawnAt    DateTime?
  worker         WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("biometric_states")
}

model BiometricReview {
  id                String              @id @default(uuid())
  workerId          String
  reviewerId        String
  kind              String
  evidenceReference String
  evidenceDigest    String
  reason            String
  approvedAt        DateTime            @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  epoch             Int
  worker            WorkerProfile       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  reviewer          User                @relation("BiometricReviewer", fields: [reviewerId], references: [id])
  templates         BiometricTemplate[]
  sessions          BiometricSession[]

  @@unique([id, workerId, epoch], map: "biometric_review_binding_key")
  @@index([workerId, revokedAt, expiresAt])
  @@map("biometric_reviews")
}

model BiometricTemplate {
  id             String             @id @default(uuid())
  workerId       String
  version        Int
  epoch          Int
  reviewId       String
  modelVersion   String
  keyId          String
  encrypted      Json?
  consentVersion String
  createdAt      DateTime           @default(now())
  revokedAt      DateTime?
  deletedAt      DateTime?
  worker         WorkerProfile      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  review         BiometricReview    @relation(fields: [reviewId, workerId, epoch], references: [id, workerId, epoch], onDelete: Restrict, onUpdate: Restrict)
  sessions       BiometricSession[]
  proofs         BiometricProof[]

  @@unique([id, workerId, version, epoch, modelVersion], map: "biometric_template_binding_key")
  @@unique([workerId, version])
  @@map("biometric_templates")
}

model BiometricSession {
  id               String             @id @default(uuid())
  workerId         String
  userId           String
  purpose          String
  orderId          String?
  requestKey       String
  epoch            Int
  templateId       String?
  templateVersion  Int
  modelVersion     String
  reviewId         String
  nonceHash        String
  state            String             @default("PENDING")
  attempts         Int                @default(0)
  captureDigest    String?
  claimId          String?
  errorCode        String?
  createdAt        DateTime           @default(now())
  expiresAt        DateTime
  consumedAt       DateTime?
  worker           WorkerProfile      @relation(fields: [workerId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  order            Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  template         BiometricTemplate? @relation(fields: [templateId, workerId, templateVersion, epoch, modelVersion], references: [id, workerId, version, epoch, modelVersion], onDelete: Restrict, onUpdate: Restrict)
  review           BiometricReview    @relation(fields: [reviewId, workerId, epoch], references: [id, workerId, epoch], onDelete: Restrict, onUpdate: Restrict)
  proof            BiometricProof?    @relation("BiometricProofSession")
  orderBoundProofs BiometricProof[]   @relation("BiometricProofOrder")

  @@unique([id, workerId, templateId, templateVersion, epoch, purpose, modelVersion], map: "biometric_session_binding_key")
  @@unique([id, orderId], map: "biometric_session_order_key")
  @@unique([workerId, requestKey])
  @@index([workerId, createdAt])
  @@map("biometric_sessions")
}

model BiometricProof {
  id              String            @id @default(uuid())
  sessionId       String            @unique
  workerId        String
  templateId      String
  templateVersion Int
  epoch           Int
  purpose         String
  orderId         String?
  modelVersion    String
  padModelVersion String
  policyVersion   String
  identityScore   Float
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  session         BiometricSession  @relation("BiometricProofSession", fields: [sessionId, workerId, templateId, templateVersion, epoch, purpose, modelVersion], references: [id, workerId, templateId, templateVersion, epoch, purpose, modelVersion], onDelete: Restrict, onUpdate: Restrict)
  worker          WorkerProfile     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  template        BiometricTemplate @relation(fields: [templateId, workerId, templateVersion, epoch, modelVersion], references: [id, workerId, version, epoch, modelVersion], onDelete: Restrict, onUpdate: Restrict)
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderSession    BiometricSession? @relation("BiometricProofOrder", fields: [sessionId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sessionId, workerId, templateId, templateVersion, epoch, purpose, modelVersion], map: "biometric_proof_binding_key")
  @@index([workerId, purpose, expiresAt])
  @@index([orderId, consumedAt])
  @@map("biometric_proofs")
}

model BiometricAudit {
  id        String   @id @default(uuid())
  actorId   String
  workerId  String
  action    String
  reason    String
  targetId  String?
  createdAt DateTime @default(now())

  @@index([workerId, createdAt])
  @@map("biometric_audits")
}
