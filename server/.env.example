# Copy to a private .env and supply your own credentials. Never commit real values.
PORT=3000
NODE_ENV=development

# Explicit PostgreSQL/PostGIS configuration; placeholders are not usable credentials.
DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:5432/CHANGE_ME_DATABASE?schema=public"
REDIS_URL="redis://127.0.0.1:6380"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380

# Runtime JWT setting used by JwtModule/JwtStrategy. Generate independent random secrets.
JWT_SECRET="CHANGE_ME_RANDOM_JWT_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_RANDOM_REFRESH_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"

AI_SERVICE_URL="http://127.0.0.1:8000"
AI_CONFIDENCE_THRESHOLD="0.6"
AI_FACE_SERVICE_TOKEN="CHANGE_ME_PRIVATE_AI_SERVICE_TOKEN"

# External integrations: use separate authorized development/QA accounts.
SMTP_HOST="CHANGE_ME_SMTP_HOST"
SMTP_PORT=587
SMTP_USER="CHANGE_ME_SMTP_USERNAME"
SMTP_PASS="CHANGE_ME_SMTP_PASSWORD"
ESMS_API_KEY="CHANGE_ME_ESMS_API_KEY"
ESMS_SECRET_KEY="CHANGE_ME_ESMS_SECRET_KEY"
ESMS_BRANDNAME="CHANGE_ME_ESMS_BRAND"
ESMS_SMS_TYPE="2"
ESMS_SANDBOX="1"
GOOGLE_CLIENT_ID="CHANGE_ME_WEB_CLIENT_ID"
GOOGLE_ANDROID_CLIENT_ID="CHANGE_ME_ANDROID_CLIENT_ID"
FIREBASE_PROJECT_ID="CHANGE_ME_FIREBASE_PROJECT"
FIREBASE_SERVICE_ACCOUNT_PATH="/private/path/to/service-account.json"
CLOUDINARY_CLOUD_NAME="CHANGE_ME_CLOUD_NAME"
CLOUDINARY_API_KEY="CHANGE_ME_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="CHANGE_ME_CLOUDINARY_API_SECRET"

# Keep gates closed until schema, approvals and evaluated providers are ready.
FACE_CORE_ENABLED=false
FACE_BIOMETRIC_CAPTURE_APPROVED=false
SYMPTOM_CATALOG_ENABLED=false
