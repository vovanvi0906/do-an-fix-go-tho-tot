# ================================================================
# FIXGO MOBILE - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env hoặc .env.local và điền giá trị tương ứng
# ================================================================

# API & WebSocket Endpoints (Hỗ trợ Local IP LAN hoặc Ngrok HTTPS Tunnel)
EXPO_PUBLIC_API_URL=http://<YOUR_LOCAL_IP>:3000/api
# Hoặc dùng Ngrok Tunnel:
# EXPO_PUBLIC_API_URL=https://<YOUR_NGROK_SUBDOMAIN>.ngrok-free.dev/api

EXPO_PUBLIC_SOCKET_URL=http://<YOUR_LOCAL_IP>:3000
# Hoặc dùng Ngrok Tunnel:
# EXPO_PUBLIC_SOCKET_URL=https://<YOUR_NGROK_SUBDOMAIN>.ngrok-free.dev

EXPO_PUBLIC_ENV=development

# Google Sign-In OAuth Client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_WEB_CLIENT_ID>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<YOUR_GOOGLE_WEB_CLIENT_ID>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<YOUR_GOOGLE_ANDROID_CLIENT_ID>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://auth.expo.io/@<YOUR_EXPO_USERNAME>/doan-kltn-mobile

# Firebase Client Configuration (Dành cho Firebase Auth & Push Notifications)
EXPO_PUBLIC_FIREBASE_API_KEY=<YOUR_FIREBASE_API_KEY>
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<YOUR_PROJECT_ID>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_REDIRECT_HANDLER=https://<YOUR_PROJECT_ID>.firebaseapp.com/__/auth/handler
EXPO_PUBLIC_FIREBASE_PROJECT_ID=<YOUR_PROJECT_ID>
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=<YOUR_PROJECT_ID>.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<YOUR_MESSAGING_SENDER_ID>
EXPO_PUBLIC_FIREBASE_APP_ID=<YOUR_FIREBASE_APP_ID>
EXPO_PUBLIC_FIREBASE_GOOGLE_WEB_CLIENT_ID=<YOUR_FIREBASE_WEB_CLIENT_ID>.apps.googleusercontent.com
